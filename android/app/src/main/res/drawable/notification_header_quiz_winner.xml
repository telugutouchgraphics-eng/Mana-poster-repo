<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#FFFF3D6E"
                android:centerColor="#FF8B5CF6"
                android:endColor="#FF06B6D4"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFFFD54A" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:right="8dp"
        android:top="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#22FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
