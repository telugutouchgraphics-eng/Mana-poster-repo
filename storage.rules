rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isCreator() {
      return request.auth != null &&
        (request.auth.token.creator == true || request.auth.token.admin == true);
    }

    function isManager() {
      return request.auth != null &&
        (request.auth.token.manager == true || request.auth.token.admin == true);
    }

    function isAllowedImageUpload(maxSizeBytes) {
      return request.resource != null &&
        request.resource.size < maxSizeBytes &&
        request.resource.contentType.matches('image/.*');
    }

    function isAllowedPosterImageUpload() {
      return request.resource != null &&
        request.resource.size <= 500 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/rembg_jobs/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isAllowedImageUpload(15 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/poster_profile/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isAllowedImageUpload(15 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    // Community contribution uploads used for manager review queue.
    match /users/{userId}/community_uploads/{fileName} {
      allow read: if isOwner(userId) || isManager();
      allow create, update: if isOwner(userId) &&
        isAllowedPosterImageUpload();
      allow delete: if isOwner(userId) || isManager();
    }

    // Short-lived community status images. Firestore controls who can see
    // status records; storage names remain unguessable per user/doc id.
    match /users/{userId}/status_uploads/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) &&
        isAllowedImageUpload(2 * 1024 * 1024);
      allow delete: if isOwner(userId) || isManager();
    }

    match /landing-media/{mediaId}/{fileName} {
      allow read, create, update, delete: if false;
    }

    match /landing-site/{allPaths=**} {
      allow read, create, update, delete: if false;
    }

    // Public read: creatorPosters docs store storage paths served on the anonymous
    // home feed — without this, clients cannot mint fresh download URLs for other
    // users' uploads. Writes stay creator-scoped via create/update/delete below.
    match /creator-posters/{userId}/{posterId}/{fileName} {
      allow read: if true;
      allow create, update: if isCreator() &&
        request.auth.uid == userId &&
        isAllowedPosterImageUpload();
      allow delete: if isAdmin() || (isCreator() && request.auth.uid == userId);
    }

    match /premium-templates/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        isAllowedPosterImageUpload();
      allow delete: if isAdmin();
    }

    match /portal_assets/admin_app_posters/{categoryId}/{posterId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isAllowedPosterImageUpload();
      allow delete: if isAdmin();
    }

    // Legacy admin-upload poster assets are already published in the public
    // home feed via creatorPosters docs. Keep reads public so older records
    // can resolve safely without auth errors.
    match /portal_assets/admin_upload_posters/{categoryId}/{posterId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isAllowedPosterImageUpload();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
