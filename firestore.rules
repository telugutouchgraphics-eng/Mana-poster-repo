rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isManager() {
      return signedIn() && request.auth.token.manager == true;
    }

    function isModerator() {
      return isAdmin() || isManager();
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validPlatform(value) {
      return value in ["android", "ios", "web", "other"];
    }

    function profileKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        "displayName",
        "nameTelugu",
        "nameEnglish",
        "whatsappNumber",
        "nameFontFamily",
        "photoUrl",
        "originalPhotoUrl",
        "identityMode",
        "businessName",
        "businessTagline",
        "businessWhatsappNumber",
        "businessLogoUrl",
        "businessLogoStyleId",
        "updatedAt",
      ]);
    }

    function validPosterProfileWrite() {
      return profileKeysAllowed() &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 120 &&
        request.resource.data.nameTelugu is string &&
        request.resource.data.nameTelugu.size() <= 120 &&
        request.resource.data.nameEnglish is string &&
        request.resource.data.nameEnglish.size() <= 120 &&
        request.resource.data.whatsappNumber is string &&
        request.resource.data.whatsappNumber.size() <= 30 &&
        request.resource.data.nameFontFamily is string &&
        request.resource.data.nameFontFamily.size() <= 80 &&
        request.resource.data.photoUrl is string &&
        request.resource.data.photoUrl.size() <= 2000 &&
        request.resource.data.originalPhotoUrl is string &&
        request.resource.data.originalPhotoUrl.size() <= 2000 &&
        request.resource.data.identityMode in ["personal", "business"] &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() <= 120 &&
        request.resource.data.businessTagline is string &&
        request.resource.data.businessTagline.size() <= 180 &&
        request.resource.data.businessWhatsappNumber is string &&
        request.resource.data.businessWhatsappNumber.size() <= 30 &&
        request.resource.data.businessLogoUrl is string &&
        request.resource.data.businessLogoUrl.size() <= 2000 &&
        request.resource.data.businessLogoStyleId is string &&
        request.resource.data.businessLogoStyleId.size() <= 40;
    }

    function tokenKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        "token",
        "platform",
        "uid",
        "createdAt",
        "updatedAt",
        "welcomeSent",
        "welcomeSentAt",
        "allNotifications",
        "newPosters",
        "offersUpdates",
        "subscriptionReminders",
      ]);
    }

    function validNotificationPreferenceFlags() {
      return (!("allNotifications" in request.resource.data) ||
          request.resource.data.allNotifications is bool) &&
        (!("newPosters" in request.resource.data) ||
          request.resource.data.newPosters is bool) &&
        (!("offersUpdates" in request.resource.data) ||
          request.resource.data.offersUpdates is bool) &&
        (!("subscriptionReminders" in request.resource.data) ||
          request.resource.data.subscriptionReminders is bool);
    }

    function validUserTokenWrite(userId, tokenId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "token",
          "platform",
          "uid",
          "createdAt",
          "updatedAt",
          "welcomeSent",
          "welcomeSentAt",
          "allNotifications",
          "newPosters",
          "offersUpdates",
          "subscriptionReminders",
        ]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 40 &&
        validPlatform(request.resource.data.platform) &&
        request.resource.data.uid == userId &&
        validNotificationPreferenceFlags();
    }

    function validPublicTokenWrite(tokenId) {
      return request.resource.data.token is string &&
        request.resource.data.token.size() > 40 &&
        validPlatform(request.resource.data.platform) &&
        validNotificationPreferenceFlags();
    }

    function validUserRootWrite(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "preferredLanguage",
          "updatedAt",
        ]) &&
        (!("preferredLanguage" in request.resource.data) ||
          (request.resource.data.preferredLanguage is string &&
            request.resource.data.preferredLanguage in [
              "telugu",
              "english",
              "hindi",
              "tamil",
              "kannada",
              "malayalam",
            ]));
    }

    function validActiveSessionWrite(userId) {
      return request.resource.data.keys().hasOnly([
          "activeDeviceId",
          "uid",
          "email",
          "platform",
          "updatedAt",
        ]) &&
        request.resource.data.activeDeviceId is string &&
        request.resource.data.activeDeviceId.size() >= 8 &&
        request.resource.data.activeDeviceId.size() <= 160 &&
        request.resource.data.uid == userId &&
        (!("email" in request.resource.data) ||
          request.resource.data.email == null ||
          request.resource.data.email is string) &&
        validPlatform(request.resource.data.platform);
    }

    function validUserUploadStatus(value) {
      return value in ["pending", "approved", "rejected"];
    }

    function validUserPosterUploadCreate() {
      return request.resource.data.keys().hasOnly([
          "id",
          "contributionKind",
          "userId",
          "userName",
          "userEmail",
          "userMobile",
          "imageUrl",
          "imagePath",
          "categoryId",
          "categoryLabel",
          "status",
          "rejectionReason",
          "approvedPosterTemplateId",
          "shareCount",
          "downloadCount",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "appVisibleFromAt",
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.contributionKind == "user_upload" &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName is string &&
        request.resource.data.userName.size() > 0 &&
        request.resource.data.userEmail is string &&
        request.resource.data.userMobile is string &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.size() > 0 &&
        request.resource.data.imagePath is string &&
        request.resource.data.imagePath.matches("^users/" + request.auth.uid + "/community_uploads/.*") &&
        request.resource.data.categoryId is string &&
        request.resource.data.categoryId.size() > 0 &&
        request.resource.data.categoryLabel is string &&
        request.resource.data.categoryLabel.size() > 0 &&
        request.resource.data.status == "pending" &&
        request.resource.data.rejectionReason == "" &&
        request.resource.data.approvedPosterTemplateId == "" &&
        request.resource.data.shareCount == 0 &&
        request.resource.data.downloadCount == 0 &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.expiresAt is int &&
        request.resource.data.appVisibleFromAt is int;
    }

    function validOwnerUserPosterUploadCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "shareCount",
          "downloadCount",
          "updatedAt",
        ]) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.status == "approved" &&
        request.resource.data.rejectionReason == resource.data.rejectionReason &&
        request.resource.data.approvedPosterTemplateId == resource.data.approvedPosterTemplateId &&
        request.resource.data.shareCount is int &&
        request.resource.data.downloadCount is int &&
        request.resource.data.shareCount >= resource.data.shareCount &&
        request.resource.data.downloadCount >= resource.data.downloadCount &&
        request.resource.data.updatedAt is int;
    }

    // Direct client access to subscription entitlements is read-only for owner.
    // Writes must go through trusted backend (Cloud Functions with Admin SDK).
    match /users/{userId}/entitlements/{entitlementId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Optional purchase event view: owner can read own events only.
    match /users/{userId}/purchaseEvents/{eventId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // User-owned poster profile sync for app-side profile persistence.
    match /users/{userId}/posterProfile/{profileId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPosterProfileWrite();
      allow delete: if isOwner(userId);
    }

    // User root document stores lightweight app-owned preferences like language.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserRootWrite(userId);
      allow delete: if false;
    }

    // User-owned device FCM tokens for push notification delivery.
    match /users/{userId}/deviceTokens/{tokenId} {
      allow read: if isOwner(userId);
      // Keep owner-only write access, but avoid over-strict shape checks that
      // can block token sync on real devices and break push delivery.
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Single-device session ownership per user account.
    match /users/{userId}/activeSession/{sessionId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validActiveSessionWrite(userId);
      allow delete: if isOwner(userId);
    }

    // App-open token capture before login to send welcome push.
    match /publicDeviceTokens/{tokenId} {
      allow create, update: if validPublicTokenWrite(tokenId);
      allow read, delete: if false;
    }

    // Free feed can read only manager-approved creator posters.
    match /creatorPosters/{posterId} {
      allow read: if resource.data.status == "approved";
      allow create, update, delete: if false;
    }

    // Public app banners for home/category promotional surfaces.
    match /appBanners/{bannerId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    // Community contribution uploads. Owners can create/read their own uploads.
    // Manager/Admin review updates are allowed via moderator claims (or server SDK).
    match /userPosterUploads/{uploadId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isModerator());

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        validUserPosterUploadCreate();

      // Owner can only increment contribution counts on approved uploads.
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        validOwnerUserPosterUploadCounterUpdate();

      // Manager/Admin can review (approve/reject) and update status fields.
      allow update: if isModerator();
      allow delete: if false;
    }

    // Website/landing pages are intentionally not connected to app portals.
    match /websitePosters/{posterId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // Keep app portal settings readable, but do not expose landing-page config.
    match /websiteConfig/{docId} {
      allow read: if docId == "portalSettings";
      allow create, update, delete: if false;
    }

    // Landing CMS collections are disabled; dashboards must not publish pages.
    match /landingSite/{docId} {
      allow read, create, update, delete: if false;
    }

    match /landingDrafts/{draftId} {
      allow read, create, update, delete: if false;
    }

    match /landingPublished/{docId} {
      allow read, create, update, delete: if false;
    }

    // Landing/media library is disabled with landing CMS.
    match /mediaLibrary/{mediaId} {
      allow read, create, update, delete: if false;
    }

    match /landingVersions/{versionId} {
      allow read, create, update, delete: if false;
    }

    // Admin-only activity/audit history for dashboard actions.
    match /adminAuditLogs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Block all other direct access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
