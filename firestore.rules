rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isManager() {
      return signedIn() && request.auth.token.manager == true;
    }

    function isModerator() {
      return isAdmin() || isManager();
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validPlatform(value) {
      return value in ["android", "ios", "web", "other"];
    }

    function posterProfileAllowedKeys() {
      return [
        "displayName",
        "nameTelugu",
        "nameEnglish",
        "whatsappNumber",
        "nameFontFamily",
        "photoUrl",
        "originalPhotoUrl",
        "identityMode",
        "businessName",
        "businessTagline",
        "businessWhatsappNumber",
        "businessLogoUrl",
        "businessLogoStyleId",
        "setupCompleted",
        "personalPhotoRevision",
        "personalPhotoSyncPending",
        "profileRevision",
        "updatedAt",
      ];
    }

    function profileKeysAllowed() {
      return resource == null
        ? request.resource.data.keys().hasOnly(posterProfileAllowedKeys())
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(posterProfileAllowedKeys());
    }

    function validPosterProfileWrite() {
      return profileKeysAllowed() &&
        (!("displayName" in request.resource.data) ||
          (request.resource.data.displayName is string &&
            request.resource.data.displayName.size() <= 120)) &&
        (!("nameTelugu" in request.resource.data) ||
          (request.resource.data.nameTelugu is string &&
            request.resource.data.nameTelugu.size() <= 120)) &&
        (!("nameEnglish" in request.resource.data) ||
          (request.resource.data.nameEnglish is string &&
            request.resource.data.nameEnglish.size() <= 120)) &&
        (!("whatsappNumber" in request.resource.data) ||
          (request.resource.data.whatsappNumber is string &&
            request.resource.data.whatsappNumber.size() <= 30)) &&
        (!("nameFontFamily" in request.resource.data) ||
          (request.resource.data.nameFontFamily is string &&
            request.resource.data.nameFontFamily.size() <= 80)) &&
        (!("photoUrl" in request.resource.data) ||
          (request.resource.data.photoUrl is string &&
            request.resource.data.photoUrl.size() <= 2000)) &&
        (!("originalPhotoUrl" in request.resource.data) ||
          (request.resource.data.originalPhotoUrl is string &&
            request.resource.data.originalPhotoUrl.size() <= 2000)) &&
        (!("identityMode" in request.resource.data) ||
          request.resource.data.identityMode in ["personal", "business"]) &&
        (!("businessName" in request.resource.data) ||
          (request.resource.data.businessName is string &&
            request.resource.data.businessName.size() <= 120)) &&
        (!("businessTagline" in request.resource.data) ||
          (request.resource.data.businessTagline is string &&
            request.resource.data.businessTagline.size() <= 180)) &&
        (!("businessWhatsappNumber" in request.resource.data) ||
          (request.resource.data.businessWhatsappNumber is string &&
            request.resource.data.businessWhatsappNumber.size() <= 30)) &&
        (!("businessLogoUrl" in request.resource.data) ||
          (request.resource.data.businessLogoUrl is string &&
            request.resource.data.businessLogoUrl.size() <= 2000)) &&
        (!("businessLogoStyleId" in request.resource.data) ||
          (request.resource.data.businessLogoStyleId is string &&
            request.resource.data.businessLogoStyleId.size() <= 40)) &&
        (!("setupCompleted" in request.resource.data) ||
          request.resource.data.setupCompleted is bool) &&
        (!("personalPhotoRevision" in request.resource.data) ||
          request.resource.data.personalPhotoRevision is int) &&
        (!("personalPhotoSyncPending" in request.resource.data) ||
          request.resource.data.personalPhotoSyncPending is bool) &&
        (!("profileRevision" in request.resource.data) ||
          request.resource.data.profileRevision is int);
    }

    function validNotificationPreferenceFlags() {
      return (!("allNotifications" in request.resource.data) ||
          request.resource.data.allNotifications is bool) &&
        (!("newPosters" in request.resource.data) ||
          request.resource.data.newPosters is bool) &&
        (!("offersUpdates" in request.resource.data) ||
          request.resource.data.offersUpdates is bool) &&
        (!("subscriptionReminders" in request.resource.data) ||
          request.resource.data.subscriptionReminders is bool);
    }

    function validPublicTokenWrite() {
      return request.resource.data.keys().hasOnly([
          "token",
          "platform",
          "uid",
          "preferredLanguage",
          "selectedRegion",
          "selectedRegionName",
          "selectedRegionLanguage",
          "selectedRegionLanguageCode",
          "religionPreference",
          "allNotifications",
          "newPosters",
          "offersUpdates",
          "subscriptionReminders",
          "createdAt",
          "updatedAt",
          "welcomeSent",
        ]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 40 &&
        validPlatform(request.resource.data.platform) &&
        (!("uid" in request.resource.data) ||
          request.resource.data.uid is string) &&
        (!("preferredLanguage" in request.resource.data) ||
          request.resource.data.preferredLanguage is string) &&
        (!("selectedRegion" in request.resource.data) ||
          request.resource.data.selectedRegion is string) &&
        (!("selectedRegionName" in request.resource.data) ||
          request.resource.data.selectedRegionName is string) &&
        (!("selectedRegionLanguage" in request.resource.data) ||
          request.resource.data.selectedRegionLanguage is string) &&
        (!("selectedRegionLanguageCode" in request.resource.data) ||
          request.resource.data.selectedRegionLanguageCode is string) &&
        (!("religionPreference" in request.resource.data) ||
          request.resource.data.religionPreference is string) &&
        (!("welcomeSent" in request.resource.data) ||
          request.resource.data.welcomeSent is bool) &&
        validNotificationPreferenceFlags();
    }

    function validUserRootWrite() {
      return resource == null
        ? request.resource.data.keys().hasOnly([
            "preferredLanguage",
            "religionPreference",
            "selectedRegion",
            "selectedRegionName",
            "selectedRegionLanguage",
            "selectedRegionLanguageCode",
            "selectedPartyIds",
            "selectedParties",
            "locationEnabled",
            "locationArea",
            "locationUpdatedAt",
            "statusFeedSeed",
            "updatedAt",
          ])
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "preferredLanguage",
            "religionPreference",
            "selectedRegion",
            "selectedRegionName",
            "selectedRegionLanguage",
            "selectedRegionLanguageCode",
            "selectedPartyIds",
            "selectedParties",
            "locationEnabled",
            "locationArea",
            "locationUpdatedAt",
            "statusFeedSeed",
            "updatedAt",
          ]);
    }

    function validActiveSessionWrite(userId) {
      return request.resource.data.keys().hasOnly([
          "activeDeviceId",
          "uid",
          "email",
          "platform",
          "regionId",
          "regionName",
          "regionLanguage",
          "appVersion",
          "buildNumber",
          "updatedAt",
        ]) &&
        request.resource.data.activeDeviceId is string &&
        request.resource.data.activeDeviceId.size() >= 8 &&
        request.resource.data.activeDeviceId.size() <= 160 &&
        request.resource.data.uid == userId &&
        (!("email" in request.resource.data) ||
          request.resource.data.email == null ||
          request.resource.data.email is string) &&
        (!("regionId" in request.resource.data) ||
          request.resource.data.regionId is string) &&
        (!("regionName" in request.resource.data) ||
          request.resource.data.regionName is string) &&
        (!("regionLanguage" in request.resource.data) ||
          request.resource.data.regionLanguage is string) &&
        (!("appVersion" in request.resource.data) ||
          request.resource.data.appVersion is string) &&
        (!("buildNumber" in request.resource.data) ||
        request.resource.data.buildNumber is string) &&
        validPlatform(request.resource.data.platform);
    }

    function validUserPosterUploadCreate() {
      return request.resource.data.keys().hasOnly([
          "id",
          "contributionKind",
          "userId",
          "userName",
          "userEmail",
          "userMobile",
          "imageUrl",
          "imagePath",
          "quoteText",
          "submissionType",
          "hasImage",
          "categoryId",
          "categoryLabel",
          "regionId",
          "regionName",
          "status",
          "rejectionReason",
          "approvedPosterTemplateId",
          "shareCount",
          "downloadCount",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "appVisibleFromAt",
          "widthPx",
          "heightPx",
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.contributionKind == "user_upload" &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName is string &&
        request.resource.data.userName.size() > 0 &&
        request.resource.data.userEmail is string &&
        request.resource.data.userMobile is string &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imagePath is string &&
        (
          (
            !("quoteText" in request.resource.data) &&
            !("submissionType" in request.resource.data) &&
            !("hasImage" in request.resource.data) &&
            request.resource.data.imageUrl.size() > 0 &&
            request.resource.data.imagePath.matches("^users/" + request.auth.uid + "/community_uploads/.*")
          ) ||
          (
            request.resource.data.quoteText is string &&
            request.resource.data.quoteText.size() <= 600 &&
            request.resource.data.submissionType in ["image", "quote", "image_quote"] &&
            request.resource.data.hasImage is bool &&
            (
              (
                request.resource.data.hasImage == true &&
                request.resource.data.imageUrl.size() > 0 &&
                request.resource.data.imagePath.matches("^users/" + request.auth.uid + "/community_uploads/.*") &&
                request.resource.data.submissionType in ["image", "image_quote"]
              ) ||
              (
                request.resource.data.hasImage == false &&
                request.resource.data.imageUrl == "" &&
                request.resource.data.imagePath == "" &&
                request.resource.data.submissionType == "quote"
              )
            ) &&
            (
              request.resource.data.imageUrl.size() > 0 ||
              request.resource.data.quoteText.size() > 0
            ) &&
            (
              (request.resource.data.submissionType == "image" && request.resource.data.quoteText == "") ||
              (request.resource.data.submissionType == "quote" && request.resource.data.quoteText.size() > 0) ||
              (request.resource.data.submissionType == "image_quote" && request.resource.data.quoteText.size() > 0)
            )
          )
        ) &&
        request.resource.data.categoryId is string &&
        request.resource.data.categoryId.size() > 0 &&
        request.resource.data.categoryLabel is string &&
        request.resource.data.categoryLabel.size() > 0 &&
        request.resource.data.regionId is string &&
        request.resource.data.regionId.size() > 0 &&
        request.resource.data.regionName is string &&
        request.resource.data.regionName.size() > 0 &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.regionId ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRegion &&
        request.resource.data.status == "pending" &&
        request.resource.data.rejectionReason == "" &&
        request.resource.data.approvedPosterTemplateId == "" &&
        request.resource.data.shareCount == 0 &&
        request.resource.data.downloadCount == 0 &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.expiresAt is int &&
        request.resource.data.appVisibleFromAt is int &&
        (!("widthPx" in request.resource.data) ||
          request.resource.data.widthPx is int) &&
        (!("heightPx" in request.resource.data) ||
          request.resource.data.heightPx is int);
    }

    function validOwnerUserPosterUploadCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "shareCount",
          "downloadCount",
          "updatedAt",
        ]) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.status == "approved" &&
        request.resource.data.rejectionReason == resource.data.rejectionReason &&
        request.resource.data.approvedPosterTemplateId == resource.data.approvedPosterTemplateId &&
        request.resource.data.shareCount is int &&
        request.resource.data.downloadCount is int &&
        request.resource.data.shareCount >= resource.data.shareCount &&
        request.resource.data.downloadCount >= resource.data.downloadCount &&
        request.resource.data.updatedAt is int;
    }

    function validCreatorPosterEngagementUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "shareCount",
          "downloadCount",
          "engagementCount",
          "updatedAt",
        ]) &&
        resource.data.status == "approved" &&
        resource.data.regionId is string &&
        resource.data.regionId.size() > 0 &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.regionId ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRegion &&
        request.resource.data.shareCount is int &&
        request.resource.data.downloadCount is int &&
        request.resource.data.engagementCount is int &&
        (!("shareCount" in resource.data) ||
          request.resource.data.shareCount >= resource.data.shareCount) &&
        (!("downloadCount" in resource.data) ||
          request.resource.data.downloadCount >= resource.data.downloadCount) &&
        (!("engagementCount" in resource.data) ||
          request.resource.data.engagementCount >= resource.data.engagementCount) &&
        request.resource.data.updatedAt is int;
    }

    function validCreatorPosterDailyStatsWrite(statId) {
      return request.resource.data.keys().hasOnly([
          "creatorPublicId",
          "posterId",
          "templateId",
          "posterTitle",
          "categoryId",
          "categoryLabel",
          "regionId",
          "dateKey",
          "shareCount",
          "downloadCount",
          "totalEngagement",
          "createdAt",
          "updatedAt",
        ]) &&
        request.resource.data.creatorPublicId is string &&
        request.resource.data.creatorPublicId.size() > 0 &&
        request.resource.data.posterId is string &&
        request.resource.data.posterId.size() > 0 &&
        request.resource.data.templateId == request.resource.data.posterId &&
        statId == request.resource.data.posterId + "-" + request.resource.data.dateKey &&
        request.resource.data.posterTitle is string &&
        request.resource.data.posterTitle.size() <= 160 &&
        request.resource.data.categoryId is string &&
        request.resource.data.categoryId.size() <= 120 &&
        request.resource.data.categoryLabel is string &&
        request.resource.data.categoryLabel.size() <= 160 &&
        request.resource.data.regionId is string &&
        request.resource.data.regionId.size() <= 120 &&
        request.resource.data.dateKey is string &&
        request.resource.data.dateKey.size() == 10 &&
        request.resource.data.shareCount is int &&
        request.resource.data.downloadCount is int &&
        request.resource.data.totalEngagement is int &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/creatorPosters/$(request.resource.data.posterId)) &&
        get(/databases/$(database)/documents/creatorPosters/$(request.resource.data.posterId)).data.status == "approved" &&
        get(/databases/$(database)/documents/creatorPosters/$(request.resource.data.posterId)).data.regionId ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRegion &&
        (resource == null ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "shareCount",
              "downloadCount",
              "totalEngagement",
              "updatedAt",
            ]) &&
            request.resource.data.creatorPublicId == resource.data.creatorPublicId &&
            request.resource.data.posterId == resource.data.posterId &&
            request.resource.data.templateId == resource.data.templateId &&
            request.resource.data.posterTitle == resource.data.posterTitle &&
            request.resource.data.categoryId == resource.data.categoryId &&
            request.resource.data.categoryLabel == resource.data.categoryLabel &&
            request.resource.data.regionId == resource.data.regionId &&
            request.resource.data.dateKey == resource.data.dateKey &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.shareCount >= resource.data.shareCount &&
            request.resource.data.downloadCount >= resource.data.downloadCount &&
            request.resource.data.totalEngagement >= resource.data.totalEngagement));
    }

    function validCreatorPosterDailyStatsRead(statId) {
      return resource.data.posterId is string &&
        resource.data.posterId.size() > 0 &&
        resource.data.dateKey is string &&
        resource.data.dateKey.size() == 10 &&
        statId == resource.data.posterId + "-" + resource.data.dateKey &&
        exists(/databases/$(database)/documents/creatorPosters/$(resource.data.posterId)) &&
        get(/databases/$(database)/documents/creatorPosters/$(resource.data.posterId)).data.status == "approved";
    }

    function validCommunityStatusCreate() {
      return request.resource.data.keys().hasOnly([
          "id",
          "userId",
          "userName",
          "userPhotoUrl",
          "imageUrl",
          "imagePath",
          "text",
          "statusType",
          "regionId",
          "regionName",
          "religionPreference",
          "locationState",
          "locationDistrict",
          "locationCity",
          "backgroundColor",
          "viewCount",
          "likeCount",
          "reactionCount",
          "viewsByUser",
          "likesByUser",
          "reactionsByUser",
          "createdAt",
          "updatedAt",
          "expiresAt",
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName is string &&
        request.resource.data.userName.size() > 0 &&
        request.resource.data.userName.size() <= 120 &&
        request.resource.data.userPhotoUrl is string &&
        request.resource.data.userPhotoUrl.size() <= 2000 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.size() <= 2000 &&
        request.resource.data.imagePath is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 300 &&
        request.resource.data.statusType in ["image", "text", "image_text"] &&
        request.resource.data.regionId is string &&
        request.resource.data.regionId.size() > 0 &&
        request.resource.data.regionId.size() <= 80 &&
        request.resource.data.regionName is string &&
        request.resource.data.regionName.size() <= 120 &&
        request.resource.data.religionPreference in [
          "hindu",
          "muslim",
          "christian",
          "all",
        ] &&
        request.resource.data.locationState is string &&
        request.resource.data.locationState.size() <= 120 &&
        request.resource.data.locationDistrict is string &&
        request.resource.data.locationDistrict.size() <= 120 &&
        request.resource.data.locationCity is string &&
        request.resource.data.locationCity.size() <= 120 &&
        request.resource.data.backgroundColor is int &&
        request.resource.data.viewCount is int &&
        request.resource.data.viewCount == 0 &&
        request.resource.data.likeCount is int &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.reactionCount is int &&
        request.resource.data.reactionCount == 0 &&
        request.resource.data.viewsByUser is map &&
        request.resource.data.viewsByUser.size() == 0 &&
        request.resource.data.likesByUser is map &&
        request.resource.data.likesByUser.size() == 0 &&
        request.resource.data.reactionsByUser is map &&
        request.resource.data.reactionsByUser.size() == 0 &&
        (
          (
            request.resource.data.statusType == "text" &&
            request.resource.data.imageUrl == "" &&
            request.resource.data.imagePath == "" &&
            request.resource.data.text.size() > 0
          ) ||
          (
            request.resource.data.statusType == "image" &&
            request.resource.data.imageUrl.size() > 0 &&
            request.resource.data.imagePath.matches("^users/" + request.auth.uid + "/status_uploads/.*") &&
            request.resource.data.text == ""
          ) ||
          (
            request.resource.data.statusType == "image_text" &&
            request.resource.data.imageUrl.size() > 0 &&
            request.resource.data.imagePath.matches("^users/" + request.auth.uid + "/status_uploads/.*") &&
            request.resource.data.text.size() > 0
          )
        ) &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.expiresAt is int &&
        request.resource.data.expiresAt > request.resource.data.createdAt &&
        request.resource.data.expiresAt <= request.resource.data.createdAt + 86400000;
    }

    function validCommunityStatusEngagementUpdate() {
      return signedIn() &&
        canReadCommunityStatus() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "viewCount",
          "likeCount",
          "reactionCount",
          "viewsByUser",
          "likesByUser",
          "reactionsByUser",
          "updatedAt",
        ]) &&
        request.resource.data.viewCount is int &&
        request.resource.data.viewCount >= 0 &&
        request.resource.data.likeCount is int &&
        request.resource.data.likeCount >= 0 &&
        request.resource.data.reactionCount is int &&
        request.resource.data.reactionCount >= 0 &&
        request.resource.data.viewsByUser is map &&
        request.resource.data.likesByUser is map &&
        request.resource.data.reactionsByUser is map &&
        request.resource.data.updatedAt is int;
    }

    function validCommunityStatusCommentCreate(statusId) {
      let status = get(/databases/$(database)/documents/communityStatuses/$(statusId)).data;
      return signedIn() &&
        canReadCommunityStatusData(status) &&
        status.userId != request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "id",
          "statusId",
          "statusOwnerId",
          "userId",
          "userName",
          "text",
          "createdAt",
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.statusId == statusId &&
        request.resource.data.statusOwnerId == status.userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName is string &&
        request.resource.data.userName.size() > 0 &&
        request.resource.data.userName.size() <= 120 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 220 &&
        request.resource.data.createdAt is int;
    }

    function canReadCommunityStatusData(status) {
      return signedIn() &&
        (
          status.userId == request.auth.uid ||
          canReadCommunityStatusForViewer(
            status,
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          )
        );
    }

    function canReadCommunityStatusForViewer(status, viewer) {
      return statusMatchesViewerLocation(status, viewer) ||
        (
          !viewerHasLocationArea(viewer) &&
          status.regionId == viewer.selectedRegion
        );
    }

    function viewerHasLocationArea(viewer) {
      return viewer.locationEnabled == true &&
        viewer.locationArea is map &&
        (
          (viewer.locationArea.city is string && viewer.locationArea.city.size() > 0) ||
          (viewer.locationArea.district is string && viewer.locationArea.district.size() > 0) ||
          (viewer.locationArea.state is string && viewer.locationArea.state.size() > 0)
        );
    }

    function statusMatchesViewerLocation(status, viewer) {
      return viewerHasLocationArea(viewer) &&
        (
          (
            status.locationCity is string &&
            status.locationCity.size() > 0 &&
            viewer.locationArea.city is string &&
            status.locationCity == viewer.locationArea.city
          ) ||
          (
            status.locationDistrict is string &&
            status.locationDistrict.size() > 0 &&
            viewer.locationArea.district is string &&
            status.locationDistrict == viewer.locationArea.district
          ) ||
          (
            status.locationState is string &&
            status.locationState.size() > 0 &&
            viewer.locationArea.state is string &&
            status.locationState == viewer.locationArea.state
          )
        );
    }

    function canDeleteCommunityStatus() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function canReadCommunityStatus() {
      return canReadCommunityStatusData(resource.data);
    }

    function canReadCommunityStatusComment(statusId) {
      let status = get(/databases/$(database)/documents/communityStatuses/$(statusId)).data;
      return signedIn() &&
        canReadCommunityStatusData(status) &&
        (
          status.userId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        );
    }

    function validCommunityContentReportCreate() {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          "id",
          "contentType",
          "statusId",
          "commentId",
          "reportedUserId",
          "reportedUserName",
          "reporterUserId",
          "reporterName",
          "reporterEmail",
          "reason",
          "details",
          "statusTextPreview",
          "commentTextPreview",
          "statusImagePath",
          "regionId",
          "regionName",
          "religionPreference",
          "locationState",
          "locationDistrict",
          "locationCity",
          "statusCreatedAt",
          "reportedAt",
          "reviewStatus",
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.contentType in ["status", "comment"] &&
        request.resource.data.statusId is string &&
        request.resource.data.statusId.size() > 0 &&
        request.resource.data.commentId is string &&
        request.resource.data.commentId.size() <= 160 &&
        request.resource.data.reportedUserId is string &&
        request.resource.data.reportedUserId.size() > 0 &&
        request.resource.data.reportedUserId != request.auth.uid &&
        request.resource.data.reportedUserName is string &&
        request.resource.data.reportedUserName.size() <= 120 &&
        request.resource.data.reporterUserId == request.auth.uid &&
        request.resource.data.reporterName is string &&
        request.resource.data.reporterName.size() > 0 &&
        request.resource.data.reporterName.size() <= 120 &&
        request.resource.data.reporterEmail is string &&
        request.resource.data.reporterEmail.size() <= 320 &&
        request.resource.data.reason in [
          "Harassment or bullying",
          "Hate speech or discrimination",
          "Sexual or adult content",
          "Violence or dangerous content",
          "Spam, scam, or fake content",
          "Misinformation or deceptive political content",
          "Privacy violation or personal information",
          "Copyright or trademark issue",
          "Illegal content",
          "Other safety issue",
        ] &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 500 &&
        request.resource.data.statusTextPreview is string &&
        request.resource.data.statusTextPreview.size() <= 300 &&
        request.resource.data.commentTextPreview is string &&
        request.resource.data.commentTextPreview.size() <= 220 &&
        request.resource.data.statusImagePath is string &&
        request.resource.data.statusImagePath.size() <= 2000 &&
        request.resource.data.regionId is string &&
        request.resource.data.regionId.size() <= 80 &&
        request.resource.data.regionName is string &&
        request.resource.data.regionName.size() <= 120 &&
        request.resource.data.religionPreference is string &&
        request.resource.data.religionPreference.size() <= 40 &&
        request.resource.data.locationState is string &&
        request.resource.data.locationState.size() <= 120 &&
        request.resource.data.locationDistrict is string &&
        request.resource.data.locationDistrict.size() <= 120 &&
        request.resource.data.locationCity is string &&
        request.resource.data.locationCity.size() <= 120 &&
        request.resource.data.statusCreatedAt is int &&
        request.resource.data.reportedAt is int &&
        request.resource.data.reviewStatus == "pending";
    }

    // Direct client access to subscription entitlements is read-only for owner.
    // Writes must go through trusted backend (Cloud Functions with Admin SDK).
    match /users/{userId}/entitlements/{entitlementId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Optional purchase event view: owner can read own events only.
    match /users/{userId}/purchaseEvents/{eventId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // User-owned poster profile sync for app-side profile persistence.
    match /users/{userId}/posterProfile/{profileId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPosterProfileWrite();
      allow delete: if isOwner(userId);
    }

    // User-owned reusable transparent profile cutouts for editor reuse.
    match /users/{userId}/savedCutoutPhotos/{cutoutId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // User root document stores lightweight app-owned preferences like language.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserRootWrite();
      allow delete: if false;
    }

    // User-owned device FCM tokens for push notification delivery.
    match /users/{userId}/deviceTokens/{tokenId} {
      allow read: if isOwner(userId);
      // Keep owner-only write access, but avoid over-strict shape checks that
      // can block token sync on real devices and break push delivery.
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Single-device session ownership per user account.
    match /users/{userId}/activeSession/{sessionId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validActiveSessionWrite(userId);
      allow delete: if isOwner(userId);
    }

    // App-open token capture before login to send welcome push.
    match /publicDeviceTokens/{tokenId} {
      allow create, update: if validPublicTokenWrite();
      allow read, delete: if false;
    }

    // Free feed reads approved posters for the selected State/UT. Telugu and
    // Hindi language groups share only non-political content; party categories
    // stay state-specific.
    match /creatorPosters/{posterId} {
      allow read: if signedIn() &&
        resource.data.status == "approved" &&
        resource.data.regionId is string &&
        resource.data.regionId.size() > 0;
      allow update: if signedIn() && validCreatorPosterEngagementUpdate();
      allow create, delete: if false;
    }

    // Per-day creator performance counters for approved poster share/download actions.
    match /creatorPosterDailyStats/{statId} {
      allow create, update: if signedIn() && validCreatorPosterDailyStatsWrite(statId);
      allow read: if signedIn() && validCreatorPosterDailyStatsRead(statId);
      allow delete: if false;
    }

    // Public app banners for home/category promotional surfaces.
    match /appBanners/{bannerId} {
      allow read: if resource.data.active == true;
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "viewCount",
          "lastViewedAt",
        ]) &&
        request.resource.data.viewCount is int &&
        resource.data.viewCount is int &&
        request.resource.data.viewCount == resource.data.viewCount + 1 &&
        request.resource.data.lastViewedAt == request.time;
      allow create, delete: if false;
    }

    // Admin-uploaded political protocol photos shown as public overlays in app.
    match /politicalProtocolPhotos/{photoId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    // Admin-replaced political party logos shown in public app UI.
    match /politicalPartyLogos/{partyId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    // Public political party catalog managed by the portal backend.
    // Active=false documents are readable so the app can hide built-in fallback parties.
    match /politicalParties/{partyId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Published editor asset catalog. Administration uses the trusted portal
    // server SDK; mobile clients can never write catalog records directly.
    match /editorAssetCategories/{categoryId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    match /editorAssets/{assetId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    match /editorFonts/{fontId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    // Admin-created manual event categories used to show event chips in app.
    match /manualEventCategories/{categoryId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    // Admin-created always-on categories used to show permanent chips in app.
    match /permanentCategories/{categoryId} {
      allow read: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    // Community contribution uploads. Owners can create/read their own uploads.
    // Manager/Admin review updates are allowed via moderator claims (or server SDK).
    match /userPosterUploads/{uploadId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isModerator());

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        validUserPosterUploadCreate();

      // Owner can only increment contribution counts on approved uploads.
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        validOwnerUserPosterUploadCounterUpdate();

      // Manager/Admin can review (approve/reject) and update status fields.
      allow update: if isModerator();
      allow delete: if false;
    }

    // Short-lived community statuses are visible to nearby users when location is available,
    // with selected State/UT fallback when the viewer has no location area.
    match /communityStatuses/{statusId} {
      allow read: if canReadCommunityStatus();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        validCommunityStatusCreate();
      allow update: if validCommunityStatusEngagementUpdate();
      allow delete: if canDeleteCommunityStatus();

      match /comments/{commentId} {
        allow read: if canReadCommunityStatusComment(statusId);
        allow create: if validCommunityStatusCommentCreate(statusId);
        allow update: if false;
        allow delete: if signedIn() &&
          get(/databases/$(database)/documents/communityStatuses/$(statusId)).data.userId == request.auth.uid;
      }
    }

    // User safety reports for community statuses and status replies.
    // Users can submit reports; only moderators can read or resolve them.
    match /communityContentReports/{reportId} {
      allow create: if validCommunityContentReportCreate();
      allow read, update, delete: if isModerator();
    }

    // Website/landing pages are intentionally not connected to app portals.
    match /websitePosters/{posterId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // Keep app portal settings readable, but do not expose landing-page config.
    match /websiteConfig/{docId} {
      allow read: if docId == "portalSettings" || docId.matches("^portalSettings_[A-Za-z0-9_]+$");
      allow create, update, delete: if false;
    }

    // Landing CMS collections are disabled; dashboards must not publish pages.
    match /landingSite/{docId} {
      allow read, create, update, delete: if false;
    }

    match /landingDrafts/{draftId} {
      allow read, create, update, delete: if false;
    }

    match /landingPublished/{docId} {
      allow read, create, update, delete: if false;
    }

    // Landing/media library is disabled with landing CMS.
    match /mediaLibrary/{mediaId} {
      allow read, create, update, delete: if false;
    }

    match /landingVersions/{versionId} {
      allow read, create, update, delete: if false;
    }

    // Daily quiz lifetime stats are written only by Cloud Functions.
    // A signed-in user can read only their own profile summary.
    match /userQuizStats/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /quizPrizeProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Admin-only activity/audit history for dashboard actions.
    match /adminAuditLogs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Block all other direct access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
